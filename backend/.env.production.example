# Application
NODE_ENV=production
PORT=3000
APP_NAME=Resto DZ API
APP_URL=https://api.restodz.dz
ALLOWED_ORIGINS=https://restodz.dz,https://www.restodz.dz

# Database
DATABASE_URL=postgresql://resto_dz_user:STRONG_PASSWORD@db:5432/resto_dz
DB_HOST=db
DB_PORT=5432
DB_USERNAME=resto_dz_user
DB_PASSWORD=STRONG_PASSWORD_CHANGE_ME
DB_DATABASE=resto_dz

# JWT — Use strong random values!
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING
JWT_REFRESH_SECRET=CHANGE_ME_TO_DIFFERENT_RANDOM_64_CHAR_STRING
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# File Upload
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Storage
STORAGE_PROVIDER=local

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info